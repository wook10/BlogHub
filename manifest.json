{
  "manifest_version": 3,
  "name": "VelogHub",
  "version": "0.1.0",
  "description": "velog에 출간한 글을 GitHub 저장소에 자동으로 커밋합니다.",
  "action": { "default_popup": "popup/popup.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://velog.io/*"], "js": ["src/velog-hook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://velog.io/*"], "js": ["src/content.js"], "run_at": "document_start" }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"]
}
