{
  "manifest_version": 3,
  "name": "BlogHub",
  "version": "1.1.1",
  "description": "velog·티스토리에 발행한 글을 GitHub 저장소에 자동으로 커밋합니다.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://velog.io/*"], "js": ["src/velog-hook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://velog.io/*"], "js": ["src/content.js"], "run_at": "document_start" },
    { "matches": ["https://*.tistory.com/manage/*"], "js": ["src/tistory-hook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://*.tistory.com/manage/*"], "js": ["src/content.js"], "run_at": "document_start" }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://v2.velog.io/*",
    "https://velog.velcdn.com/*",
    "https://images.velog.io/*",
    "https://*.tistory.com/*",
    "https://blog.kakaocdn.net/*"
  ]
}
