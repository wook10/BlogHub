{
  "manifest_version": 3,
  "name": "VelogHub",
  "version": "0.1.0",
  "description": "velog에 출간한 글을 GitHub 저장소에 자동으로 커밋합니다.",
  "action": { "default_popup": "popup/popup.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"]
}
